# =============================================
# ARCHIVO DE EJEMPLO — Renombrar a: .env
# Copiar este archivo y completar con los datos reales
# =============================================

# Servidor
PORT=4000

# Base de datos PostgreSQL
DB_USER=tu_usuario_postgres
DB_PASSWORD=tu_contraseña_postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tu_nombre_bd

# Seguridad JWT (generar una clave larga y aleatoria)
JWT_SECRET=cambiar_por_una_clave_secreta_larga

# Correo para recuperación de contraseñas (Gmail)
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password_de_gmail

# URL del frontend
FRONTEND_URL=http://localhost:5173
